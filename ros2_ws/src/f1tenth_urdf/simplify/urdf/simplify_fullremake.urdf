  <!-- basefootprint: intentionally an invisible coordinate frame. No visual /
       collision blocks so rviz doesn't try to render an empty mesh. Inertial
       kept (all zeros) for KDL — robot_state_publisher accepts that. -->
  <link
    name="basefootprint">
    <inertial>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <mass
        value="0" />
      <inertia
        ixx="0"
        ixy="0"
        ixz="0"
        iyy="0"
        iyz="0"
        izz="0" />
    </inertial>
  </link>
  <!-- REP-105: basefootprint is the root (ground-level frame, z=0 in odom).
       base_link is parented to it at +wheel_radius+axle offset so the
       wheel bottoms sit on basefootprint's plane.  Flipped from the
       SolidWorks export (which had base_link as root) so robot_localization
       and slam_toolbox can use basefootprint as the canonical body frame. -->
  <joint
    name="Base_Footprint"
    type="fixed">
    <origin
      xyz="0 0 0.1189"
      rpy="0 0 0" />
    <parent
      link="basefootprint" />
    <child
      link="base_link" />
    <axis
      xyz="0 0 0" />
  </joint>
